<?xml version="1.0" encoding="UTF-8"?>
<!--
  V-Team weekly calibration + CTO report — Mondays 08:00.

  Weekday 1 = Monday. Fires on wake if the Mac was off, so a report is never
  silently skipped — the thing that makes a scheduled job worse than no job is
  believing it ran.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>so.indianvcs.vteam.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__VT_ROOT__/scripts/weekly.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <key>WorkingDirectory</key>
  <string>__VT_ROOT__</string>

  <key>StandardOutPath</key>
  <string>/tmp/vteam-weekly.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/vteam-weekly.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
